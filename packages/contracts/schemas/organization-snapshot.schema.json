{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bandi.local/contracts/organization-snapshot.schema.json",
  "title": "Bandi Organization Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "companies", "departments", "roles", "workspaces", "serviceGrants"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "companies": { "type": "array", "items": { "$ref": "#/$defs/company" } },
    "departments": { "type": "array", "items": { "$ref": "#/$defs/department" } },
    "roles": { "type": "array", "items": { "$ref": "#/$defs/role" } },
    "workspaces": { "type": "array", "items": { "$ref": "#/$defs/workspace" } },
    "serviceGrants": { "type": "array", "items": { "$ref": "#/$defs/serviceGrant" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
    "text": { "type": "string", "maxLength": 16384 },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "texts": { "type": "array", "maxItems": 512, "items": { "type": "string", "minLength": 1, "maxLength": 16384 } },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "mission", "boundary", "departmentIds", "workspaceIds", "sharedAssetIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "mission": { "$ref": "#/$defs/text" }, "boundary": { "$ref": "#/$defs/text" },
        "assistantAgentId": { "$ref": "#/$defs/id" }, "departmentIds": { "$ref": "#/$defs/ids" }, "workspaceIds": { "$ref": "#/$defs/ids" }, "sharedAssetIds": { "$ref": "#/$defs/ids" }
      }
    },
    "department": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "companyId", "mission", "members", "responsibilities", "boundaries", "delegationDepth", "memberAgentIds", "ownedSopIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "companyId": { "$ref": "#/$defs/id" }, "parentDepartmentId": { "$ref": "#/$defs/id" }, "parent": { "$ref": "#/$defs/text" }, "managerAgentId": { "$ref": "#/$defs/id" }, "manager": { "$ref": "#/$defs/text" }, "mission": { "$ref": "#/$defs/text" },
        "members": { "type": "integer", "minimum": 0 }, "responsibilities": { "$ref": "#/$defs/texts" }, "boundaries": { "$ref": "#/$defs/texts" }, "delegationDepth": { "type": "integer", "minimum": 1, "maximum": 32 }, "memberAgentIds": { "$ref": "#/$defs/ids" }, "ownedSopIds": { "$ref": "#/$defs/ids" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "companyId", "name", "status", "mission", "responsibilities", "inputs", "deliverables", "decisionBoundaries", "escalationConditions", "completionDefinition"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "companyId": { "$ref": "#/$defs/id" }, "departmentId": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "status": { "enum": ["active", "archived"] }, "mission": { "$ref": "#/$defs/text" }, "responsibilities": { "$ref": "#/$defs/texts" }, "inputs": { "$ref": "#/$defs/texts" }, "deliverables": { "$ref": "#/$defs/texts" }, "decisionBoundaries": { "$ref": "#/$defs/texts" }, "escalationConditions": { "$ref": "#/$defs/texts" }, "completionDefinition": { "$ref": "#/$defs/texts" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path", "collaboratorDepartmentIds", "config", "health", "agentIds", "assetIds", "publicMemorySpaceId", "departmentMemorySpaceIds", "files", "recentEdits"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "path": { "$ref": "#/$defs/text" }, "company": { "$ref": "#/$defs/text" }, "department": { "$ref": "#/$defs/text" }, "companyId": { "$ref": "#/$defs/id" }, "primaryDepartmentId": { "$ref": "#/$defs/id" }, "projectLeadAgentId": { "$ref": "#/$defs/id" }, "collaboratorDepartmentIds": { "$ref": "#/$defs/ids" }, "config": { "$ref": "#/$defs/text" }, "health": { "$ref": "#/$defs/text" }, "agentIds": { "$ref": "#/$defs/ids" }, "assetIds": { "$ref": "#/$defs/ids" }, "publicMemorySpaceId": { "$ref": "#/$defs/id" }, "departmentMemorySpaceIds": { "$ref": "#/$defs/ids" }, "files": { "type": "array" }, "recentEdits": { "type": "array" }
      }
    },
    "serviceGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "agentId", "departmentId", "capabilities", "workspaceIds", "prohibitions", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "agentId": { "$ref": "#/$defs/id" }, "departmentId": { "$ref": "#/$defs/id" }, "capabilities": { "$ref": "#/$defs/texts" }, "workspaceIds": { "$ref": "#/$defs/ids" }, "prohibitions": { "$ref": "#/$defs/texts" }, "status": { "enum": ["有效", "暂停"] }
      }
    }
  }
}
