{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bandi.local/contracts/memory-review.schema.json",
  "title": "Bandi Formal Memory Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "space",
    "candidate",
    "reviewRequest",
    "savedResult"
  ],
  "properties": {
    "space": {
      "$ref": "#/$defs/space"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "reviewRequest": {
      "$ref": "#/$defs/reviewRequest"
    },
    "savedResult": {
      "$ref": "#/$defs/savedResult"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootKind",
        "displayPath",
        "relativePath"
      ],
      "properties": {
        "rootKind": {
          "enum": [
            "managed",
            "workspace"
          ]
        },
        "displayPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "assetId",
        "containerId",
        "assetContentHash",
        "containerContentHash"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "assetId": {
          "$ref": "#/$defs/id"
        },
        "containerId": {
          "$ref": "#/$defs/id"
        },
        "assetContentHash": {
          "$ref": "#/$defs/hash"
        },
        "containerContentHash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "scopeKey": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "agentId"
          ],
          "properties": {
            "kind": {
              "const": "agent_long_term"
            },
            "agentId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "agentId",
            "workspaceId"
          ],
          "properties": {
            "kind": {
              "const": "agent_workspace"
            },
            "agentId": {
              "$ref": "#/$defs/id"
            },
            "workspaceId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "workspaceId"
          ],
          "properties": {
            "kind": {
              "const": "workspace_shared"
            },
            "workspaceId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "departmentId",
            "workspaceId"
          ],
          "properties": {
            "kind": {
              "const": "department_workspace"
            },
            "departmentId": {
              "$ref": "#/$defs/id"
            },
            "workspaceId": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scopeType",
        "scopeKey",
        "owner",
        "stewardAgentId",
        "reviewerAgentId",
        "reviewPolicy",
        "visibilityPolicy",
        "storageProfileVersion",
        "state",
        "storageLocator",
        "contentHash",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "scopeType": {
          "enum": [
            "agent_long_term",
            "agent_workspace",
            "workspace_shared",
            "department_workspace"
          ]
        },
        "scopeKey": {
          "$ref": "#/$defs/scopeKey"
        },
        "stewardAgentId": {
          "$ref": "#/$defs/id"
        },
        "reviewerAgentId": {
          "$ref": "#/$defs/id"
        },
        "reviewPolicy": {
          "const": "independent_reviewer"
        },
        "visibilityPolicy": {
          "enum": [
            "agent_private",
            "workspace_shared",
            "department_workspace"
          ]
        },
        "storageLocator": {
          "$ref": "#/$defs/locator"
        },
        "currentRevisionId": {
          "$ref": "#/$defs/id"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "storageProfileVersion": {
          "const": "memory-v1"
        },
        "state": {
          "enum": [
            "active",
            "read_only_history"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label"
      ],
      "properties": {
        "kind": {
          "enum": [
            "manual",
            "import"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "spaceId",
        "proposerAgentId",
        "reviewerAgentId",
        "source",
        "summary",
        "proposedContent",
        "proposedContentHash",
        "submittedBaseline",
        "status",
        "version",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "spaceId": {
          "$ref": "#/$defs/id"
        },
        "proposerAgentId": {
          "$ref": "#/$defs/id"
        },
        "reviewerAgentId": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "proposedContent": {
          "type": "string",
          "maxLength": 1048576
        },
        "proposedContentHash": {
          "$ref": "#/$defs/hash"
        },
        "submittedBaseline": {
          "$ref": "#/$defs/baseline"
        },
        "status": {
          "enum": [
            "pending_review",
            "changes_requested",
            "rejected",
            "approved_pending_write",
            "written",
            "revision_pending"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "reviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "candidateId",
        "decision",
        "expectedCandidateVersion",
        "expectedBaseline"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/id"
        },
        "candidateId": {
          "$ref": "#/$defs/id"
        },
        "decision": {
          "enum": [
            "request_changes",
            "reject",
            "approve"
          ]
        },
        "expectedCandidateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "expectedBaseline": {
          "$ref": "#/$defs/baseline"
        },
        "comment": {
          "type": "string",
          "maxLength": 16384
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "candidateId",
        "actorAgentId",
        "decision",
        "decidedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "candidateId": {
          "$ref": "#/$defs/id"
        },
        "actorAgentId": {
          "$ref": "#/$defs/id"
        },
        "decision": {
          "enum": [
            "request_changes",
            "reject",
            "approve"
          ]
        },
        "comment": {
          "type": "string",
          "maxLength": 16384
        },
        "decidedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "spaceId",
        "candidateId",
        "reviewDecisionId",
        "proposerAgentId",
        "reviewerAgentId",
        "sourceContentHash",
        "contentHash",
        "storageLocator",
        "writeReceiptId",
        "writtenAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "spaceId": {
          "$ref": "#/$defs/id"
        },
        "parentRevisionId": {
          "$ref": "#/$defs/id"
        },
        "candidateId": {
          "$ref": "#/$defs/id"
        },
        "reviewDecisionId": {
          "$ref": "#/$defs/id"
        },
        "proposerAgentId": {
          "$ref": "#/$defs/id"
        },
        "reviewerAgentId": {
          "$ref": "#/$defs/id"
        },
        "sourceContentHash": {
          "$ref": "#/$defs/hash"
        },
        "contentHash": {
          "$ref": "#/$defs/hash"
        },
        "storageLocator": {
          "$ref": "#/$defs/locator"
        },
        "writeReceiptId": {
          "$ref": "#/$defs/id"
        },
        "writtenAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "containerId",
        "previousContainerHash",
        "writtenContainerHash",
        "verifiedAt",
        "atomicReplace"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "containerId": {
          "$ref": "#/$defs/id"
        },
        "previousContainerHash": {
          "$ref": "#/$defs/hash"
        },
        "writtenContainerHash": {
          "$ref": "#/$defs/hash"
        },
        "verifiedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "atomicReplace": {
          "const": true
        }
      }
    },
    "savedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "requestId",
        "candidate",
        "decision",
        "revision",
        "writeReceipt"
      ],
      "properties": {
        "kind": {
          "const": "saved"
        },
        "requestId": {
          "$ref": "#/$defs/id"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "decision": {
          "$ref": "#/$defs/decision"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "writeReceipt": {
          "$ref": "#/$defs/receipt"
        }
      }
    },
    "owner": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "agentId"
          ],
          "properties": {
            "kind": {
              "const": "agent"
            },
            "agentId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "workspaceId"
          ],
          "properties": {
            "kind": {
              "const": "workspace"
            },
            "workspaceId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "departmentId",
            "workspaceId"
          ],
          "properties": {
            "kind": {
              "const": "department_workspace"
            },
            "departmentId": {
              "$ref": "#/$defs/id"
            },
            "workspaceId": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    }
  }
}
