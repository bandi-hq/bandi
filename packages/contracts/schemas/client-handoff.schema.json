{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bandi.local/contracts/client-handoff.schema.json",
  "title": "Bandi Client Handoff",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/result" }
  ],
  "$defs": {
    "clientId": {
      "enum": ["claude-code", "claude-desktop", "codex", "gemini-cli", "grok-build", "opencode", "openclaw", "hermes", "pi"]
    },
    "adapterId": {
      "enum": ["claude-code-terminal-v1", "claude-desktop-config-v1", "codex-terminal-v1", "gemini-cli-terminal-v1", "grok-build-config-v1", "opencode-terminal-v1", "openclaw-terminal-v1", "hermes-terminal-v1", "pi-terminal-v1"]
    },
    "terminalId": {
      "enum": ["terminal", "iterm2", "warp", "ghostty", "wezterm", "kitty", "alacritty"]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "adapterId", "workspaceId", "terminalId", "intent"],
      "properties": {
        "clientId": { "$ref": "#/$defs/clientId" },
        "adapterId": { "$ref": "#/$defs/adapterId" },
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
        "terminalId": { "$ref": "#/$defs/terminalId" },
        "intent": { "const": "continue_workspace" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "evidence", "remediation"],
      "properties": {
        "status": { "enum": ["supported", "degraded", "unavailable", "not_checked"] },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "remediation": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "adapterId", "workspaceId", "terminalId", "intent", "capability", "outcome"],
      "properties": {
        "clientId": { "$ref": "#/$defs/clientId" },
        "adapterId": { "$ref": "#/$defs/adapterId" },
        "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
        "terminalId": { "$ref": "#/$defs/terminalId" },
        "intent": { "const": "continue_workspace" },
        "capability": { "$ref": "#/$defs/capability" },
        "outcome": { "enum": ["accepted", "manual_required", "rejected", "not_attempted"] },
        "acceptedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
