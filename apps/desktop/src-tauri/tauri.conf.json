{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bandi",
  "version": "0.1.0",
  "identifier": "com.bandi.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir apps/web dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir apps/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [{
      "title": "Bandi · 演示模式",
      "width": 1280,
      "height": 800,
      "minWidth": 960,
      "minHeight": 640,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
