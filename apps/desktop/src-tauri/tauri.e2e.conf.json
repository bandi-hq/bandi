{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.bandi.desktop.e2e",
  "build": {
    "beforeBuildCommand": "",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "e2e",
          "description": "仅在 e2e feature 构建中允许 WebdriverIO 驱动访问测试桥接",
          "windows": ["main"],
          "permissions": [
            "wdio:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
